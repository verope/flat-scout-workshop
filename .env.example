# Every model call goes through OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenRouter slugs, as listed at https://openrouter.ai/models. Both default to
# z-ai/glm-5.3-flash, which is cheap and reads images. The text model grades
# the Criteria; the image model reads the EPC graph and the floorplan, and
# left empty it follows the text model.
OPENROUTER_TEXT_MODEL=z-ai/glm-5.3-flash
OPENROUTER_IMAGE_MODEL=
# Optional. Set it and every model call, download and run is traced to
# logfire; leave it empty and nothing is configured and nothing is sent.
# Read-and-write project token from https://logfire.pydantic.dev.
LOGFIRE_TOKEN=
